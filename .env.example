# ─────────────────────────────────────────
#  KORATEX ERP — Variables de entorno
#  Copia este archivo como .env y completa
# ─────────────────────────────────────────

# Base de datos (pega aquí el DATABASE_URL de Railway)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# JWT (cambia estos valores por strings largos y aleatorios)
JWT_SECRET=koratex_cambia_esto_por_algo_muy_largo_y_aleatorio_2025
JWT_EXPIRES_IN=8h
REFRESH_SECRET=koratex_refresh_cambia_esto_tambien_2025
REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=production

# Frontend URL (para CORS)
FRONTEND_URL=*
